# ======================================================
# LOCAL DEVELOPMENT CONFIGURATIONS: DISCORD BOT
# ======================================================
# The following environment variables drive local development configurations. 
# They are not required for production deployments, as production deployments 
# should use Kubernetes Secrets and ConfigMaps instead.

DISCORD_TOKEN=YOUR-DISCORD-TOKEN
GSM_API_HOST=GSM-API-HOST (example: localhost)
GSM_API_PORT=GSM-API-PORT (example: 80)